#include <behaviors.dtsi>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEF 0
#define GAM 1
#define GFN 2
#define NAV 3
#define SYM 4
#define NUM 5

&sk {
    release-after-ms = <60000>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers  = <NAV SYM>;
            then-layer = <NUM>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
&kp Q          &kp W          &kp E          &kp R         &kp T             &kp Y          &kp U          &kp I          &kp O          &kp P
&kp A          &kp S          &kp D          &kp F         &kp G             &kp H          &kp J          &kp K          &kp L          &kp SEMI
&kp Z          &kp X          &kp C          &kp V         &kp B             &kp N          &kp M          &kp COMMA      &kp DOT        &kp FSLH
                          &kp CAPS       &kp SPACE     &mo NAV         &mo SYM      &kp LSFT       &kp RALT
            >;
        };

        gam_layer {
            bindings = <
&kp TAB        &kp Q          &kp W          &kp E         &kp R             &none          &none          &kp UP         &none          &kp TAB
&kp LSFT       &kp A          &kp S          &kp D         &kp F             &none          &kp LEFT       &kp DOWN       &kp RIGHT      &kp RSFT
&kp LCTRL      &kp Z          &kp X          &kp C         &kp V             &none          &none          &none          &none          &kp RCTRL
                          &kp LALT       &kp SPACE     &mo GFN         &tog GAM     &kp SPACE      &trans
            >;
        };

        gfn_layer {
            bindings = <
&kp N5         &kp N1         &kp N2         &kp N3        &kp N4            &out OUT_TOG &bt BT_SEL 0 &bt BT_SEL 1   &bt BT_SEL 2 &bt BT_CLR_ALL
&kp N0         &kp N6         &kp N7         &kp N8        &kp N9            &none          &none          &none            &none          &none
&kp G          &kp J          &kp I          &kp M         &kp T             &kp KP_NUM     &none          &none            &sys_reset   &bootloader
                          &kp ESC        &kp RET       &trans          &trans       &trans       &none
            >;
        };

        nav_layer {
            bindings = <
&sk LC(TAB)  &sk LA(TAB)  &sk LG(TAB)  &none         &kp ESC           &kp ESC        &kp HOME       &kp END        &kp BSPC       &kp DEL
&sk LGUI     &sk LALT     &sk LCTRL    &sk LSHFT     &kp RET           &kp RET        &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT
&kp LC(LG(LEFT))       &kp LC(LG(RIGHT))       &tog GAM     &kp PSCRN     &kp TAB           &kp TAB        &kp PG_UP      &kp PG_DN      &kp APOS       &kp KP_NUM
                          &trans      &trans      &trans          &trans       &trans       &trans
            >;
        };

        sym_layer {
            bindings = <
&kp N1         &kp N2         &kp N3         &kp N4        &kp N5            &kp N6         &kp N7         &kp N8         &kp N9         &kp N0
&kp SEMI       &kp RA(GRAVE)        &kp GRAVE        &kp LS(GRAVE)       &kp MINUS         &kp PLUS       &sk RSHFT    &sk RCTRL    &sk LALT     &sk RGUI
&kp RA(BSLH)        &none          &kp LS(LBKT)   &kp LBKT      &kp UNDER         &kp EQUAL      &kp RBKT       &kp LS(RBKT)   &kp LS(BSLH)        &kp BSLH
                          &trans       &trans      &trans          &trans       &trans       &kp RALT
            >;
        };

        num_layer {
            bindings = <
&kp KP_N1      &kp KP_N2      &kp KP_N3      &kp KP_N4     &kp KP_N5         &kp KP_N6      &kp KP_N7      &kp KP_N8      &kp KP_N9      &kp KP_N0
&sk LGUI     &sk LALT     &sk LCTRL    &sk LSHFT   &kp F11           &kp F12        &sk RSHFT    &sk RCTRL    &sk LALT     &sk RGUI
&kp F1         &kp F2         &kp F3         &kp F4        &kp F5            &kp F6         &kp F7         &kp F8         &kp F9         &kp F10
                          &trans       &trans      &trans          &trans       &trans       &trans
            >;
        };
    };
};

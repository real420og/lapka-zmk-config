#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/ext_power.h>

#define _ &kp
#define ___ &none
#define ______ &trans

#define DEF 0
#define ARW 1
#define GAM 2
#define GFN 3
#define NAV 4
#define SYM 5
#define NUM 6
#define CMD 7
#define L5  8

#define MEH(key) LS(LC(LA(key)))

// Universal Layout bindings

#define SQuot     GRAVE
#define DQuot     LS(GRAVE)
#define Grave     RA(GRAVE)
#define Pipe      LS(BSLH)
#define Backslash RA(BSLH)
#define Nbsp      RA(SPACE)
#define Comma     LBKT
#define Semicolon LS(LBKT)
#define Dot       RBKT
#define Colon     LS(RBKT)
#define Minus     MINUS
#define Under     LS(MINUS)
#define Equal     EQUAL
#define Plus      LS(EQUAL)
#define Slash     BSLH
#define LBracket  DOT
#define LBrace    LS(DOT)
#define RBracket  FSLH
#define RBrace    LS(FSLH)
#define Ampersand COMMA
#define Tilde     SEMI

// Media keys rebinds
#define VOL_U C_VOL_UP
#define VOL_D C_VOL_DN
#define T_PRV C_PREV
#define T_NXT C_NEXT
#define T_PP  C_PP

// Window Management mapping
#define NextSpace LC(LG(RIGHT))
#define PrevSpace LC(LG(LEFT))

// Bluetooth profiles mapping
#define BT_1      &bt BT_SEL 0
#define BT_2      &bt BT_SEL 1
#define BT_3      &bt BT_SEL 2
#define BT_Clear  &bt BT_CLR_ALL
#define BT_Toggle &out OUT_TOG

// custom implementation of modified callum-mods,
// which can be released on second keypress
// and also work with swapper and/or tabber

#define PARAM_1 0
#define PARAM_2 0

#define MACRO(NAME, COMPATIBLE, BINDING_CELLS, BINDINGS) \
    NAME: NAME { \
        compatible = COMPATIBLE; \
        #binding-cells = <BINDING_CELLS>; \
        wait-ms = <0>; \
        tap-ms = <0>; \
        bindings = \
            <BINDINGS>; \
    };

#define MACRO_NO_PARAM(NAME, BINDINGS)  MACRO(NAME, "zmk,behavior-macro"          , 0, BINDINGS)
#define MACRO_ONE_PARAM(NAME, BINDINGS) MACRO(NAME, "zmk,behavior-macro-one-param", 1, BINDINGS)
#define MACRO_TWO_PARAM(NAME, BINDINGS) MACRO(NAME, "zmk,behavior-macro-two-param", 2, BINDINGS)

#define MAX_TIMER __UINT32_MAX__ // around 50 days

#define STICKY_FOREVER(NAME, BIND) \
    NAME: NAME { \
        compatible = "zmk,behavior-sticky-key"; \
        #binding-cells = <1>; \
        bindings = <BIND>; \
        release-after-ms = <MAX_TIMER>; \
        ignore-modifiers; \
    };

#define MODMORPH(NAME, NORMAL, MORPHED, MODS, KEEP_MODS) \
    NAME: NAME { \
        compatible = "zmk,behavior-mod-morph"; \
        #binding-cells = <0>; \
        bindings = <NORMAL>, <MORPHED>; \
        mods = <(MODS)>; \
        keep-mods = <(KEEP_MODS)>; \
    };

&sk {
        release-after-ms = <60000>;
};

/ {
    behaviors {
        MACRO_ONE_PARAM(
            m_release_key_twice,
            &macro_release
                &macro_param_1to1 &kp PARAM_1
                &macro_param_1to1 &kp PARAM_1
        )


        MACRO_ONE_PARAM(
            m_press_key_twice,
            &macro_press
                &macro_param_1to1 &kp PARAM_1
                &macro_param_1to1 &kp PARAM_1
            &macro_pause_for_release
            &macro_tap
                &m_release_key_twice PARAM_1
        )

        STICKY_FOREVER(sticky_forever, &m_press_key_twice)

        MODMORPH(
            cm_gui,
            &sticky_forever LGUI,
            &m_release_key_twice LGUI,
            MOD_LGUI,
            MOD_LGUI
        )

        MODMORPH(
            cm_alt,
            &sticky_forever LALT,
            &m_release_key_twice LALT,
            MOD_LALT,
            MOD_LALT
        )

        MODMORPH(
            cm_ctl,
            &sticky_forever LCTRL,
            &m_release_key_twice LCTRL,
            MOD_LCTL,
            MOD_LCTL
        )

        MODMORPH(
            cm_sft,
            &sticky_forever LSHIFT,
            &m_release_key_twice LSHIFT,
            MOD_LSFT,
            MOD_LSFT
        )

        MACRO_TWO_PARAM(
            m_hold_mod_press_key,
            &macro_press
                &macro_param_1to1 &kp PARAM_1
            &macro_tap
                &macro_param_2to1 &kp PARAM_2
        )

        MODMORPH(
            swap_ctrl,
            &m_hold_mod_press_key LCTRL TAB,
            &kp TAB,
            MOD_LCTL,
            MOD_LCTL
        )

        MODMORPH(
            swap_lalt,
            &m_hold_mod_press_key LALT TAB,
            &kp TAB,
            MOD_LALT,
            MOD_LALT
        )

        MODMORPH(
            swap_lgui,
            &m_hold_mod_press_key LGUI TAB,
            &kp TAB,
            MOD_LGUI,
            MOD_LGUI
        )

        MACRO_ONE_PARAM(
            la,
            &macro_tap
                &kp 0 // do nothing, fire all sticky keys
            &macro_press
                &macro_param_1to1 &mo PARAM_1
            &macro_pause_for_release
            &macro_release
                &macro_param_1to1 &mo PARAM_1
                &kp LSHFT
                &kp LCTRL
                &kp LALT
                &kp LGUI
        )

        tab_command: tab_command {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LG(TAB)>,
                <&macro_press>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        sl1000: sl1000 {
            compatible = "zmk,behavior-sticky-key";
            bindings = <&mo>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
        };

        tab_command_tab: tab_command_tab {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&tab_command>, <&sl1000>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_la_tui: lt_la_tui {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&la>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <60000>;
            flavor = "hold-preferred";
        };

        lt_tap_prefer_release: lt_tap_prefer_release {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            retro-tap;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers  = <NAV SYM>;
            then-layer = <NUM>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        def_layer {
            bindings = <
___         _ Q         _ W         _ E         _ R         _ T         _ Y         _ U         _ I         _ O         _ P         ___
___         _ A         _ S         _ D         _ F         _ G         _ H         _ J         _ K         _ L         _ Tilde     ___
___         _ Z         _ X         _ C         _ V         _ B         _ N         _ M         _ Ampersand _ LBracket  _ RBracket  ___
                                    _ CAPS      &la NAV     _ SPACE     &lt_tap_prefer_release ARW SPACE &lt_la_tui SYM SPACE _ RALT
            >;
        };

        arrows_layer {
            bindings = <
___         _ F1        _ F2        _ F3        _ F4        _ F5        _ LA(BSLH)  _ LA(R)     _ LA(L)     _ LA(S)     _ LA(LEFT_ARROW)        ___
___         _ F6        _ F7        _ F8        _ F9        _ F10       _ LEFT      _ DOWN      _ UP        _ RIGHT     _ LA(F7)                ___
_ LS(LA(N1)) _ F11      _ F12       _ C_VOL_DN  _ C_VOL_UP  _ C_MUTE    _ LS(LC(EQUAL)) _ LC(MINUS) _ LS(LC(MINUS)) _ LA(LC(LG(LEFT))) _ LA(LC(LG(RIGHT))) _ LS(LG(P))
                                    ______      ______      ______      ______      ___         ___
            >;
        };

        gam_layer {
            bindings = <
___         _ TAB       _ Q         _ W         _ E         _ R         ___         ___         _ UP        ___         _ TAB       ___
___         _ LSFT      _ A         _ S         _ D         _ F         ___         _ LEFT      _ DOWN      _ RIGHT     _ RSFT      ___
___         _ LCTRL     _ Z         _ X         _ C         _ V         ___         ___         ___         ___         _ RCTRL     ___
                                    _ LALT      &mo GFN     _ SPACE     _ SPACE     &tog GAM    ______
            >;
        };

        gfn_layer {
            bindings = <
___         _ N5        _ N1        _ N2        _ N3        _ N4        BT_Toggle    BT_1       BT_2        BT_3        BT_Clear       ___
___         _ N0        _ N6        _ N7        _ N8        _ N9        ___          ___        ___         ___         ___            ___
___         _ G         _ J         _ I         _ M         _ T         _ KP_NUM     ___        ___         &sys_reset  &bootloader    ___
                                    _ ESC       ______      _ RET       ______       ______     ___
            >;
        };

        nav_layer {
            bindings = <
___         &swap_ctrl  &tab_command_tab 0 L5  &swap_lgui  ___         _ ESC       _ ESC       _ HOME      _ END       _ BSPC      _ DEL       ___
___         &cm_alt     &cm_ctl     &cm_gui     &cm_sft     _ RET       _ LEFT      _ DOWN      _ UP        _ RIGHT     _ RET       ___
___         _ PrevSpace _ NextSpace &tog GAM    _ PSCRN     _ TAB       _ TAB       _ PG_UP     _ PG_DN     _ APOS      _ KP_NUM    ___
                                    &mo CMD     ______      ______      ______      ______      ______
            >;
        };

        sym_layer {
            bindings = <
___         _ N1        _ N2        _ N3        _ N4        _ N5        _ N6        _ N7        _ N8        _ N9        _ N0        ___
___         _ Tilde     _ Grave     _ SQuot     _ DQuot     _ Minus     _ Plus      &cm_sft     &cm_gui     &cm_ctl     &cm_alt     ___
___         _ Backslash ___         _ Semicolon _ Comma     _ Under     _ Equal     _ Dot       _ Colon     _ Pipe      _ Slash     ___
                                    ______      ______      ______      ______      ______      _ RALT
            >;
        };

        num_layer {
            bindings = <
___         _ KP_N1     _ KP_N2     _ KP_N3     _ KP_N4     _ KP_N5     _ KP_N6     _ KP_N7     _ KP_N8     _ KP_N9     _ KP_N0     ___
___         &cm_alt     &cm_ctl     &cm_gui     &cm_sft     _ F11       _ F12       &cm_sft     &cm_gui     &cm_ctl     &cm_alt     ___
___         _ F1        _ F2        _ F3        _ F4        _ F5        _ F6        _ F7        _ F8        _ F9        _ F10       ___
                                    ______      ______      ______      ______      ______      ______
            >;
        };

        cmd_layer {
            bindings = <
___         _ MEH(Q)    _ MEH(W)    _ MEH(E)    _ MEH(R)    _ MEH(T)    _ MEH(Y)    _ VOL_D     _ C_MUTE     _ VOL_U    _ MEH(P)    ___
___         _ MEH(A)    _ MEH(S)    _ MEH(D)    _ MEH(F)    _ MEH(G)    _ MEH(H)    _ T_PRV     _ T_PP       _ T_NXT    _ MEH(SEMI) ___
___         _ MEH(Z)    _ MEH(X)    _ MEH(C)    _ MEH(V)    _ MEH(B)    _ MEH(N)    _ MEH(M)    _ MEH(COMMA) _ MEH(DOT) _ MEH(FSLH) ___
                                    ______      ______      ______      ______      ______      ______
            >;
        };

        l5_layer {
            bindings = <
___         ___              _ LG(LA(LS(N6))) ___              ___             ___              ___         ___         ___         _ LS(LA(LG(O)))  ___              ___
___         _ LS(LA(LG(N5))) _ LG(LA(LS(P)))  _ LG(LA(LS(D)))  _ LS(LA(LG(F))) _ LG(LA(LS(G)))  ___         ___         ___         _ LS(LG(LA(N4))) ___              ___
___         _ LG(LA(LS(Z)))  _ LS(LA(LG(N2))) _ LG(LA(LS(N1))) _ LS(LA(LG(V))) _ LG(LA(LS(N3))) ___         ___         ___         _ LS(LG(LA(N6))) ___              ___
                                              ___              ___             ___              ___         ___         ___
            >;
        };
    };
};
